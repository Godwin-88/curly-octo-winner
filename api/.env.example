# Shule360 API Environment Variables
# Copy to .env and fill in with your real values

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:your_password@db.yourproject.supabase.co:5432/postgres
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# --- Upstash Vector ---
UPSTASH_VECTOR_REST_URL=https://your-upstash-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# --- Upstash Search ---
UPSTASH_SEARCH_REST_URL=https://your-upstash-search.upstash.io
UPSTASH_SEARCH_REST_TOKEN=your_upstash_search_token_here

# --- Backblaze B2 Gen2 ---
B2_ACCOUNT_ID=your_backblaze_account_id_here
B2_APPLICATION_KEY=your_backblaze_application_key_here
B2_BUCKET_NAME=shule360
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com

# --- Africa's Talking SMS ---
AT_API_KEY=your_africa_talking_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=SHULE360

# --- Meta WhatsApp Cloud API ---
META_WA_TOKEN=your_meta_whatsapp_token_here
META_WA_PHONE_NUMBER_ID=your_meta_wa_phone_number_id_here
META_WA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# --- App ---
JWT_SECRET=your_jwt_secret_here_change_this_in_production
PORT=8080
APP_ENV=development