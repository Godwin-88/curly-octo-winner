# Shule360 API Environment Variables
# Copy to .env and fill in with your real values

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:your_password@db.yourproject.supabase.co:5432/postgres
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# --- Upstash Vector ---
UPSTASH_VECTOR_REST_URL=https://your-upstash-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# --- Upstash Search ---
UPSTASH_SEARCH_REST_URL=https://your-upstash-search.upstash.io
UPSTASH_SEARCH_REST_TOKEN=your_upstash_search_token_here

# --- Backblaze B2 Gen2 ---
B2_ACCOUNT_ID=your_b2_account_id_here
B2_APPLICATION_KEY=your_b2_application_key_here
B2_BUCKET_NAME=your_b2_bucket_name_here
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# --- Africa's Talking SMS ---
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
# Leave empty to send from Africa's Talking's default short code. A name here
# must be approved for your account first, or every message is refused.
AT_SENDER_ID=
# A long random value. The delivery-report callback you register with
# Africa's Talking is https://<api host>/api/v1/webhooks/sms/dlr/<AT_DLR_TOKEN>
AT_DLR_TOKEN=
# Development only (docker compose sets it): send SMS to a local stand-in
# instead of Africa's Talking. The server refuses to start with this in production.
# AT_BASE_URL=
GROQ_API_KEY=your_groq_api_key_here

# --- Meta WhatsApp Cloud API ---
META_WA_TOKEN=your_meta_whatsapp_token_here
META_WA_PHONE_NUMBER_ID=your_meta_wa_phone_number_id_here
META_WA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# --- M-Pesa Daraja (Safaricom) ---
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_SHORT_CODE=174379
# A long random secret. It is part of the two addresses Safaricom reports to,
# which are refused without it:
#   https://<api host>/api/v1/webhooks/mpesa/<token>/stk
#   https://<api host>/api/v1/webhooks/mpesa/<token>/c2b/confirmation
MPESA_WEBHOOK_TOKEN=
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/mpesa/REPLACE_WITH_MPESA_WEBHOOK_TOKEN/stk
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- App ---
JWT_SECRET=your_jwt_secret_here_change_this_in_production
PORT=8080
APP_ENV=development
# Who may register a school themselves at /auth/register:
#   open    anyone with the address
#   code    anyone who was given SIGNUP_CODE (at least 8 characters)
#   closed  nobody; a platform administrator creates schools (Platform → Schools)
# Left unset it is closed in production and open in development.
SIGNUP_MODE=closed
SIGNUP_CODE=
