# Shule360 Web Environment Variables
# Copy to .env.local and fill in with your real values

# Go API origin that /api/v1/* requests are PROXIED to (server-side).
# The browser only ever calls same-origin /api/v1/... paths — this value is
# used by the Next.js rewrite in next.config.js, not by client code. It may
# point at the API root or include the /api/v1 suffix. Session cookies are
# first-party thanks to this same-origin proxying.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase (for Realtime inbox updates)
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here